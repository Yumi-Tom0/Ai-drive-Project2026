<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TODO App V2 (優先度 & 絞り込み対応)</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f0f2f5;
            color: #333;
            display: flex;
            justify-content: center;
            padding: 40px 16px;
        }

        .container {
            width: 100%;
            max-width: 600px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            padding: 28px;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 1.5rem;
            color: #111827;
        }

        .version-tag {
            background: #4f46e5;
            color: #fff;
            font-size: 0.75rem;
            font-weight: bold;
            padding: 2px 8px;
            border-radius: 12px;
        }

        .message {
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
            margin-bottom: 16px;
            display: none;
        }

        .message.success {
            background-color: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .message.error {
            background-color: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .form-group {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
        }

        input[type="text"] {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 0.95rem;
            outline: none;
        }

        select {
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 0.9rem;
            background: #fff;
            cursor: pointer;
        }

        button.btn-primary {
            padding: 10px 18px;
            background-color: #4f46e5;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        button.btn-primary:hover {
            background-color: #4338ca;
        }

        .filter-panel {
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-panel label {
            font-size: 0.85rem;
            color: #4b5563;
            font-weight: 600;
        }

        .counter {
            font-size: 0.85rem;
            color: #6b7280;
            margin-bottom: 12px;
        }

        ul.todo-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .todo-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            background-color: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .todo-item.completed .todo-title {
            text-decoration: line-through;
            color: #9ca3af;
        }

        .todo-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .todo-title {
            flex: 1;
            font-size: 0.95rem;
            word-break: break-all;
        }

        .badge {
            font-size: 0.75rem;
            font-weight: bold;
            padding: 2px 8px;
            border-radius: 4px;
            white-space: nowrap;
        }

        .badge-high {
            background-color: #fef2f2;
            color: #dc2626;
            border: 1px solid #fca5a5;
        }

        .badge-normal {
            background-color: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

        .badge-low {
            background-color: #f3f4f6;
            color: #4b5563;
            border: 1px solid #d1d5db;
        }

        .item-actions {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .priority-change-select {
            padding: 4px 6px;
            font-size: 0.8rem;
        }

        .btn-delete {
            padding: 6px 10px;
            background-color: #ef4444;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
        }

        .btn-delete:hover {
            background-color: #dc2626;
        }

        .empty-message {
            text-align: center;
            padding: 24px;
            color: #9ca3af;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>TODO 管理</h1>
            <span class="version-tag">V2 (優先度機能付き)</span>
        </div>

        <div id="message" class="message"></div>

        <!-- 追加フォーム -->
        <form id="todo-form" class="form-group">
            <input type="text" id="todo-title" placeholder="新しいTODOを入力..." maxlength="100" required>
            <select id="todo-priority">
                <option value="normal" selected>中 (normal)</option>
                <option value="high">高 (high)</option>
                <option value="low">低 (low)</option>
            </select>
            <button type="submit" class="btn-primary">追加</button>
        </form>

        <!-- 絞り込みパネル -->
        <div class="filter-panel">
            <label>絞り込み:</label>
            <select id="filter-status">
                <option value="all">すべての状態</option>
                <option value="false">未完了のみ</option>
                <option value="true">完了済みのみ</option>
            </select>
            <select id="filter-priority">
                <option value="all">すべての優先度</option>
                <option value="high">優先度: 高</option>
                <option value="normal">優先度: 中</option>
                <option value="low">優先度: 低</option>
            </select>
        </div>

        <div class="counter">
            表示中: <strong id="total-count">0</strong> 件
        </div>

        <!-- TODO一覧表示部 -->
        <ul id="todo-list" class="todo-list">
            <!-- JavaScriptで動的に描画されます -->
        </ul>
    </div>

    <script src="/todo/todo_v2.js"></script>
</body>

</html>